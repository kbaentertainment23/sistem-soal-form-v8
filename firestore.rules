rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Allow reading user profiles so admin can identify question owners by name & email
    match /users/{userId} {
      allow read: if true;
      allow write: if isOwner(userId);

      match /bankSoal/{setId} {
        allow read, write, delete: if true;
      }

      match /formHistory/{historyId} {
        allow read, write, delete: if isOwner(userId);
      }
    }

    // Allow collection group query on 'bankSoal' so admin can inspect and manage all question sets
    match /{path=**}/bankSoal/{setId} {
      allow read, write, delete: if true;
    }

    // Global system settings (e.g. app logo, institution branding)
    // Allows any device to load the current system branding and admins to update it
    match /system/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
